              },
              "children": [
                {
                  "element": "a",
                  "attr": {
                    "class": "footer__link",
                    "href": "https://github.com/simplybuilder/sb-core-v2/blob/main/LICENSE",
                    "style": "margin:0;"
                  },
                  "dataset": {
                    "state": "footerLicense"
                  },
                  "text": "$t:footer.license"
                }
