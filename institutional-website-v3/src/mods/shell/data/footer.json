            "class": "footer__grid"
          },
          "children": [
            {
              "element": "div",
              "children": [
                {
                  "element": "img",
                  "attr": {
                    "class": "logo-img",
                    "src": "/assets/img/logo.png"
                  }
                },
                {
                  "element": "p",
                  "attr": {
                    "class": "footer__brand-desc"
                  },
                  "dataset": {
                    "state": "footerBrand"
                  },
                  "text": "$t:footer.brand"
                }
              ]
            },
            {
              "element": "div",
              "children": [
                {
                  "element": "div",
                  "attr": {
                    "class": "footer__column-title"
                  },
                  "dataset": {
                    "state": "footerProduct"
                  },
                  "text": "$t:footer.product"
                },
                {
                  "element": "a",
                  "attr": {
                    "class": "footer__link",
                    "href": "#/playground"
                  },
                  "dataset": {
                    "state": "footerP1"
                  },
                  "text": "$t:footer.p1"
                },
                {
                  "element": "a",
                  "attr": {
                    "class": "footer__link",
                    "href": "#/docs"
                  },
                  "dataset": {
                    "state": "footerP2"
                  },
                  "text": "$t:footer.p2"
                }
              ]
            },
            {
              "element": "div",
              "children": [
                {
                  "element": "div",
                  "attr": {
                    "class": "footer__column-title"
                  },
                  "dataset": {
                    "state": "footerResources"
                  },
                  "text": "$t:footer.resources"
                },
                {
                  "element": "a",
                  "attr": {
                    "class": "footer__link",
                    "href": "https://github.com/simplybuilder"
                  },
                  "dataset": {
                    "state": "footerR3"
                  },
                  "text": "$t:footer.r3"
                },
                {
                  "element": "a",
                  "attr": {
                    "class": "footer__link",
                    "href": "https://youtube.com/@simplybuilder",
                    "target": "_blank",
                    "rel": "noopener noreferrer"
                  },
                  "dataset": {
                    "state": "footerR4"
                  },
                  "text": "$t:footer.r4"
                }
              ]
            }
          ]
        },
